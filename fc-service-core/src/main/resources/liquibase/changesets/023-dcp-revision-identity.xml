<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="2026-09-25-dcp-revision-identity" author="construct-x">
        <comment>Record verified DCP identities separately from resource state; leave historical attribution unknown.</comment>
        <addColumn tableName="revinfo">
            <column name="participant_did" type="TEXT"/>
            <column name="actor_did" type="TEXT"/>
            <column name="authentication_method" type="VARCHAR(32)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="revinfo" columnName="authentication_method"/>
            <dropColumn tableName="revinfo" columnName="actor_did"/>
            <dropColumn tableName="revinfo" columnName="participant_did"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
